# ---------------------------------------------------------------
# JECRC Student & Faculty Portal — environment configuration
# Copy to .env and adjust.  Never commit the real .env file.
# ---------------------------------------------------------------

FLASK_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-64-character-random-string

# --- Relational database ---------------------------------------
# MySQL 8 is the primary production target.  Load schema/schema.sql
# and schema/seed.sql, then set DB_ENGINE=mysql.
DB_ENGINE=sqlite
SQLITE_PATH=instance/jecrc.sqlite3

# DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=jecrc
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=jecrc_portal

# --- Sessions ---------------------------------------------------
SESSION_IDLE_MINUTES=30
SESSION_WARN_MINUTES=25
SESSION_HOURS=12
SESSION_REMEMBER_DAYS=7
# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false

# --- Uploads ----------------------------------------------------
UPLOAD_DIR=instance/uploads
MAX_UPLOAD_MB=10

# --- Security ---------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_WINDOW_MINUTES=15
ATTENDANCE_THRESHOLD=75
